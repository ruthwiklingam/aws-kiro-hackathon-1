# API Gateway base URL (from CloudFormation output: ApiGatewayUrl)
REACT_APP_API_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com/prod

# Cognito User Pool ID (from CloudFormation output: UserPoolId)
REACT_APP_USER_POOL_ID=us-east-1_XXXXXXXXX

# Cognito App Client ID (from CloudFormation output: UserPoolClientId)
REACT_APP_USER_POOL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
